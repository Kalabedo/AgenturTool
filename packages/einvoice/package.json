{
  "name": "@agentur-tool/einvoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "golden": "tsx test/write-golden.ts",
    "pruefen": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@agentur-tool/shared": "workspace:*",
    "@agentur-tool/invoice-template": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
