<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Berechtigungen für die signierte Anwendung.

  Der Hardened Runtime ist Pflicht für die Notarisierung. Chromium benötigt
  die JIT-Berechtigung; Prisma und argon2 werden als Bestandteil der App mit
  derselben Developer-ID signiert und brauchen keine Ausnahme von der
  Bibliotheksprüfung.
-->
<plist version="1.0">
  <dict>
    <!-- Chromiums JIT-Übersetzer. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!--
      Apple-Events an ein anderes Programm senden.

      Einzig für den E-Mail-Versand über Apple Mail (Abschnitt 27): Ohne
      diese Berechtigung lehnt der Hardened Runtime das AppleScript ab, das
      den Rechnungsentwurf anlegt. macOS fragt zusätzlich beim ersten Mal um
      Erlaubnis — der Text dazu steht als NSAppleEventsUsageDescription in
      electron-builder.yml.

      Wird sie verweigert, ist das kein Fehlerfall: Der Versand geht dann
      über die Nachrichtendatei.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
