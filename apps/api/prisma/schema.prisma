// Datenmodell nach docs/ARCHITEKTUR.md Abschnitt 7.
//
// Konventionen:
//   Geld          Int, in Cent            (12,34 € = 1234)
//   Mengen        Int, in Tausendstel     (7,5 h  = 7500)
//   Prozentsätze  Int, in Basispunkten    (19 %   = 1900)
//   Kalenderdaten String "YYYY-MM-DD"     (D21 — kein DateTime, keine Zeitzonen)
//   Zeitstempel   DateTime
//   Snapshots     String mit JSON-Inhalt  (Prisma kennt auf SQLite kein Json)
//   Enums         String + CHECK          (Prisma kennt auf SQLite keine enum)
//
// Die CHECK-Constraints und Trigger stehen im handverlesenen Teil der
// Migration, nicht hier — Prisma kann sie auf SQLite nicht ausdrücken.

generator client {
  provider = "prisma-client-js"

  // Jedes Installationspaket entsteht auf einem Rechner mit demselben
  // System und derselben Architektur. So passen Prisma und weitere native
  // Abhängigkeiten garantiert zum ausgelieferten Electron-Prozess.
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Eigene Firmendaten. Singleton, per CHECK auf id = 1 festgenagelt.
model Company {
  id Int @id @default(1)

  companyName String @default("")
  street      String @default("")
  postalCode  String @default("")
  city        String @default("")
  country     String @default("DE")

  email   String?
  website String?
  phone   String?

  vatId     String?
  taxNumber String?

  /// BT-34: elektronische Adresse für E-Rechnungen, samt Schema (EAS).
  electronicAddress       String?
  electronicAddressScheme String?

  bankAccountHolder String?
  iban              String?
  bic               String?
  bankName          String?

  logoAssetId Int?   @unique
  logoAsset   Asset? @relation(fields: [logoAssetId], references: [id], onDelete: SetNull)

  /// Standard-Zahlungsziel in Tagen; Vorschlag für das Fälligkeitsdatum.
  defaultPaymentTermDays Int @default(14)

  /// Standard-Stundensatz in Cent. NULL heißt „noch nicht festgelegt" — ein
  /// anderer Zustand als null Euro die Stunde. Ein Projekt darf ihn später
  /// überschreiben; hier steht nur der Vorschlag.
  defaultHourlyRateCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Hochgeladene Datei (in V1 nur das Logo). Inhalt liegt im Dateisystem.
model Asset {
  id Int @id @default(autoincrement())

  /// Pfad relativ zu DATA_DIR.
  path      String @unique
  mimeType  String
  sizeBytes Int
  /// SHA-256 des Inhalts, für die Integritätsprüfung im Backup.
  sha256    String

  originalFilename String?

  createdAt DateTime @default(now())

  company Company?
}

/// Rechnungsempfänger (Stammdaten). Auf finalisierten Rechnungen nur noch
/// Verweis für Filter und Listen — dargestellt wird der buyerData-Snapshot.
model Customer {
  id Int @id @default(autoincrement())

  /// Frei vergeben, optional, eindeutig wenn gesetzt (D22).
  /// SQLite behandelt NULL in Unique-Indizes als verschieden, deshalb sind
  /// beliebig viele Kunden ohne Nummer erlaubt.
  customerNumber String? @unique

  companyName String
  contactName String?
  addressLine String?
  street      String  @default("")
  postalCode  String  @default("")
  city        String  @default("")
  country     String  @default("DE")

  email String?
  vatId String?

  /// BT-10: Referenz des Käufers. Bei Behörden die Leitweg-ID.
  buyerReference String?

  /// BT-49: elektronische Adresse des Käufers, samt Schema (EAS).
  electronicAddress       String?
  electronicAddressScheme String?

  notes String?

  defaultTaxProfileId Int?
  defaultTaxProfile   TaxProfile? @relation(fields: [defaultTaxProfileId], references: [id], onDelete: SetNull)

  defaultPaymentTermDays Int?

  /// Weiches Löschen: Kunden mit Rechnungshistorie werden nie hart gelöscht.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices    Invoice[]
  timeEntries TimeEntry[]

  @@index([companyName])
  @@index([archivedAt])
}

/// Ein Eintrag der Zeiterfassung: ein Tag, ein Kunde, eine Spanne.
///
/// Uhrzeiten als Minuten seit Mitternacht und nicht als DateTime — aus
/// demselben Grund wie bei den Kalenderdaten (D21): Eine erfasste Zeit ist
/// eine Angabe auf der Uhr des Benutzers, kein Zeitpunkt auf der Weltlinie.
/// Alle drei Minutenfelder sind per CHECK auf Vielfache von 15 festgenagelt;
/// das Runden erledigt `timeEntryInputSchema`.
model TimeEntry {
  id Int @id @default(autoincrement())

  /// Kalendertag "YYYY-MM-DD".
  date String

  /// Restrict statt SetNull: Eine Stunde ohne Kunden ließe sich nicht mehr
  /// abrechnen und stünde als herrenloser Datensatz in jeder Auswertung.
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  startMinutes Int
  endMinutes   Int
  /// Unbezahlte Unterbrechung; wird von der Spanne abgezogen.
  breakMinutes Int @default(0)

  description String?

  /// Zeitpunkt der Abrechnung; null, solange der Eintrag offen ist.
  ///
  /// Abrechnen löscht nicht, es markiert. Die Zeiterfassung zeigt im
  /// Normalbetrieb nur die offenen Einträge — die Liste ist ein Posteingang,
  /// der sich beim Erfassen füllt und beim Abrechnen leert. Weil die Zeilen
  /// erhalten bleiben, lässt sich der Zeitnachweis jederzeit neu erzeugen,
  /// und das PDF muss nirgends aufbewahrt werden.
  billedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([customerId, date])
  /// Die Abfrage des Normalbetriebs: offene Einträge eines Kunden, nach Tag.
  @@index([customerId, billedAt, date])
  @@index([billedAt])
}

/// Konfigurierbare Steuerkonstellation. Bewusst datengetrieben statt
/// Steuerlogik im Code (docs/ARCHITEKTUR.md Abschnitt 10).
model TaxProfile {
  id Int @id @default(autoincrement())

  name String @unique
  /// STANDARD | ZERO_RATED | REVERSE_CHARGE | SMALL_BUSINESS
  kind String

  /// Vorschlag für neue Positionen, in Basispunkten.
  defaultRateBasisPoints Int @default(0)

  /// Erscheint auf der Rechnung, z. B. der Reverse-Charge-Hinweis.
  noteText String?

  /// BT-118: Steuerkategorie nach UNTDID 5305 (S, Z, E, AE, K, G, O).
  /// Steht neben `kind`, nicht darin — siehe D-E2 in Abschnitt 24.
  taxCategoryCode String @default("S")

  /// BT-121 und BT-120: Befreiungsgrund als Code beziehungsweise Klartext.
  exemptionReasonCode String?
  exemptionReasonText String?

  showTaxColumn Boolean @default(true)
  isDefault     Boolean @default(false)
  sortOrder     Int     @default(0)

  /// Archiviert statt gelöscht, sobald Rechnungen oder Kunden darauf verweisen.
  /// Ein archiviertes Profil erscheint nicht mehr in der Auswahl, bleibt aber
  /// auflösbar — Entwürfe und Kundenvorgaben zeigen sonst ins Leere.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices  Invoice[]
  customers Customer[]

  @@index([archivedAt])
}

/// Aussehen der Rechnung. Singleton in V1, per CHECK auf id = 1.
model TemplateSettings {
  id Int @id @default(1)

  templateKey String @default("classic")
  accentColor String @default("#1e293b")
  fontFamily  String @default("Open Sans")
  logoWidthMm Float  @default(40)

  /// Die weiteren Farben des Dokuments. Vorgaben wie bisher im CSS von „classic".
  inkColor     String @default("#1f2328")
  inkSoftColor String @default("#4b5563")
  ruleColor    String @default("#e3e6ea")
  bandColor    String @default("#f4f5f7")

  /// kompakt | normal | luftig — geprüft per Zod, nicht per CHECK.
  density String @default("normal")

  showLogo         Boolean @default(true)
  showPaymentBlock Boolean @default(true)
  showFooterRule   Boolean @default(true)

  footerText  String?
  paymentNote String?
  closingNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Zählerstand der Rechnungsnummern, je Scope und Jahr.
/// Storno teilt sich die Sequenz mit Rechnungen (D10).
model NumberSequence {
  id Int @id @default(autoincrement())

  /// INVOICE
  scope String
  /// Jahr aus dem Rechnungsdatum, nicht aus now() (Abschnitt 9).
  year  Int
  /// Nächste zu vergebende laufende Nummer.
  nextValue Int @default(1)

  updatedAt DateTime @updatedAt

  @@unique([scope, year])
}

/// Rechnung oder Storno-Dokument.
model Invoice {
  id Int @id @default(autoincrement())

  /// INVOICE | CANCELLATION
  documentType String @default("INVOICE")
  /// DRAFT | ISSUED | PAID | CANCELLED
  status       String @default("DRAFT")

  /// NULL genau dann, wenn status = DRAFT (D5, per CHECK erzwungen).
  number     String? @unique
  numberYear Int?
  numberSeq  Int?

  currency String @default("EUR")

  customerId   Int?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  taxProfileId Int?
  taxProfile   TaxProfile? @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)

  /// Kalenderdaten als "YYYY-MM-DD".
  invoiceDate   String
  serviceDate   String
  serviceDateTo String?
  dueDate       String

  /// Erscheint auf dem Dokument.
  notes      String?
  footerNote String?
  /// Erscheint NICHT auf dem Dokument; bleibt auch nach ISSUED änderbar.
  internalNotes String?

  /// Empfängerdaten: ab dem Entwurf befüllt und editierbar, ab ISSUED
  /// gesperrt (D9). JSON, validiert per buyerDataSchema.
  buyerData String?

  /// NULL im Entwurf, beim Finalisieren gesetzt. JSON.
  sellerSnapshot   String?
  taxSnapshot      String?
  templateSnapshot String?
  totalsSnapshot   String?
  snapshotVersion  Int?

  issuedAt    DateTime?
  sentAt      DateTime?
  /// Kalenderdatum: du gibst es ein, nicht das System.
  paidAt      String?
  cancelledAt DateTime?

  /// Verweise zwischen Rechnung und ihrem Storno.
  cancelsInvoiceId     Int?     @unique
  cancelsInvoice       Invoice? @relation("Cancellation", fields: [cancelsInvoiceId], references: [id], onDelete: Restrict)
  cancelledByInvoice   Invoice? @relation("Cancellation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InvoiceItem[]
  documents InvoiceDocument[]
  events    InvoiceEvent[]
  mails     MailMessage[]

  @@index([status])
  @@index([invoiceDate])
  @@index([customerId])
  @@index([numberYear, numberSeq])
}

/// Rechnungsposition. Bei nicht-Entwürfen per Trigger gesperrt.
model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  position    Int
  description String

  /// Tausendstel: 7,5 h = 7500
  quantity Int    @default(1000)
  /// Das gedruckte Etikett. Freitext, wie eh und je.
  unit     String?
  /// BT-130: Mengeneinheit nach UN/ECE 20. Geht nur ins XML (D-E3).
  unitCode String @default("C62")

  unitPriceCents Int @default(0)

  /// PERCENT (Basispunkte) | AMOUNT (Cent)
  discountType  String @default("PERCENT")
  discountValue Int    @default(0)

  /// Basispunkte: 19 % = 1900
  taxRateBasisPoints Int @default(0)

  /// Ergebnisse des verbindlichen Rechenwegs (Abschnitt 7), mitgespeichert,
  /// damit historische Zeilen nie nachträglich anders herauskommen.
  lineDiscountCents Int @default(0)
  lineNetCents      Int @default(0)

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

/// Erzeugte PDF-Datei. Inhalt liegt im Dateisystem (D13).
model InvoiceDocument {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// PDF | XML — dieselbe Ablage trägt beide Ausgaben einer Rechnung.
  kind String @default("PDF")

  /// Welches E-Rechnungs-Profil diese Datei trägt, oder NULL.
  ///
  /// Beantwortet die Frage, die man einer Datei sonst nicht ansieht: Ist
  /// dieses PDF ein ZUGFeRD-Dokument oder ein gewöhnliches? NULL heißt
  /// „kein strukturierter Datensatz darin" — ein Zeitnachweis, oder eine
  /// Rechnung, der beim Ausstellen Angaben fehlten.
  ///
  /// Kein CHECK-Constraint, aus demselben Grund wie bei `kind`: SQLite
  /// könnte ihn nur über einen Tabellenneubau anfügen, und der verwürfe die
  /// Trigger auf InvoiceItem. Geprüft wird gegen die Profilliste in
  /// packages/einvoice/src/profiles.ts.
  einvoiceProfile String?

  /// Pfad relativ zu DATA_DIR, z. B. invoices/2026/2026-001.pdf
  path      String @unique
  sha256    String
  sizeBytes Int

  generatedAt DateTime @default(now())

  @@index([invoiceId])
}

/// Verlaufsprotokoll. Pflicht, weil "Finalisierung zurücknehmen" eine
/// vergebene Nummer wieder freigibt — das muss nachvollziehbar bleiben.
model InvoiceEvent {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// CREATED | FINALIZED | UNFINALIZED | CANCELLED | ...
  type String
  /// JSON, validiert per invoiceEventMetadataSchema.
  metadata String?

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
}

/// Anwendungseinstellungen als Key-Value, für Kleinkram ohne eigene Tabelle.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Benutzer für die Anmeldung. Angelegt ab Schritt 13; die Tabelle entsteht
/// jetzt, damit später keine Migration an einer unangenehmen Stelle nötig ist.
model User {
  id Int @id @default(autoincrement())

  email        String  @unique
  /// argon2id
  passwordHash String
  displayName  String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions Session[]
}

/// Serverseitige Session. Kein JWT — Widerruf muss sofort wirken.
model Session {
  id Int @id @default(autoincrement())

  /// SHA-256 des Session-Tokens, nie das Token selbst.
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Einrichtung des E-Mail-Versands. Singleton, per CHECK auf id = 1.
///
/// Der Versandweg steht auf NONE, solange niemand etwas eingerichtet hat:
/// Die Anwendung greift erst nach außen, wenn es jemand ausdrücklich
/// beschlossen hat (D45).
model MailSettings {
  id Int @id @default(1)

  /// NONE | SMTP | MAIL_APP
  transport String @default("NONE")

  fromName    String?
  fromAddress String?
  replyTo     String?
  /// Blindkopie an die eigene Absenderadresse — der Beleg im eigenen Postfach.
  bccSelf     Boolean @default(false)

  host     String?
  port     Int?
  /// STARTTLS | TLS | NONE
  security String  @default("STARTTLS")
  username String?

  /// Das SMTP-Passwort, verschlüsselt (D46).
  ///
  /// Der Schlüssel liegt außerhalb der Datenbank und außerhalb des Backups:
  /// im Schlüsselbund des Betriebssystems, ersatzweise in einer Schlüsseldatei
  /// neben der Datenbank. Ein eingespieltes Backup auf einem anderen Rechner
  /// trägt diesen Wert deshalb als unlesbar mit sich — und die Einstellungen
  /// sagen das, statt den Versand daran scheitern zu lassen.
  passwordSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Textvorlage für eine der drei Versandarten.
model MailTemplate {
  id Int @id @default(autoincrement())

  /// INVOICE | CANCELLATION | TIME_REPORT — fester Satz, beim Seed angelegt.
  key String @unique

  subject String
  body    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Was verschickt wurde: das Versandprotokoll.
///
/// Eigene Tabelle und nicht bloß ein `InvoiceEvent`, weil nicht jede
/// Nachricht zu einer Rechnung gehört — ein Zeitnachweis geht auch ohne sie
/// raus. Zu einer Rechnung entsteht zusätzlich ein Verlaufseintrag; er
/// trägt die Kurzfassung, hier steht der vollständige Text.
model MailMessage {
  id Int @id @default(autoincrement())

  /// Null beim freien Zeitnachweis. SetNull statt Cascade: Das Protokoll
  /// überlebt das Löschen eines Entwurfs — was verschickt wurde, wurde
  /// verschickt.
  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// SMTP | MAIL_APP
  transport String
  /// SENT | PREPARED | FAILED
  status    String

  /// Adresslisten als JSON-Array.
  toAddresses  String
  ccAddresses  String @default("[]")
  bccAddresses String @default("[]")

  subject String
  body    String

  /// JSON: [{ kind, filename, sizeBytes }]
  attachments String @default("[]")

  /// Die Meldung des Servers, wenn der Versand fehlschlug.
  error String?

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([createdAt])
}
