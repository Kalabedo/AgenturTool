{
  "name": "@privatura/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/backup.ts --if-exists && prisma migrate dev",
    "db:deploy": "tsx scripts/backup.ts --if-exists && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:verify": "tsx prisma/verify.ts",
    "db:reset": "prisma migrate reset --force",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "user:set": "tsx scripts/user.ts"
  },
  "dependencies": {
    "@privatura/einvoice": "workspace:*",
    "@privatura/invoice-template": "workspace:*",
    "@privatura/shared": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/serve-static": "^5.0.5",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.2.0",
    "nodemailer": "^10.0.8",
    "prisma": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0"
  }
}
