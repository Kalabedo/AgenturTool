{
  "name": "agentur-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/**\" --filter \"./apps/**\" dev",
    "generate": "pnpm --filter @agentur-tool/api exec prisma generate",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "prepare:workspace": "pnpm generate && pnpm build:packages",
    "build": "pnpm prepare:workspace && pnpm --filter \"./apps/**\" build",
    "pretest": "pnpm prepare:workspace",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm prepare:workspace && pnpm -r typecheck",
    "verify": "pnpm prepare:workspace && pnpm lint && pnpm -r typecheck && vitest run && pnpm --filter \"./apps/**\" build && pnpm format:check",
    "db:migrate": "pnpm --filter @agentur-tool/api db:migrate",
    "db:seed": "pnpm --filter @agentur-tool/api db:seed",
    "chromium:install": "pnpm --filter @agentur-tool/api chromium:install",
    "backup": "pnpm --filter @agentur-tool/api backup",
    "restore": "pnpm --filter @agentur-tool/api restore",
    "user:set": "pnpm --filter @agentur-tool/api user:set",
    "db:studio": "pnpm --filter @agentur-tool/api db:studio",
    "db:verify": "pnpm --filter @agentur-tool/api db:verify",
    "db:reset": "pnpm --filter @agentur-tool/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "multer": "2.3.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "electron",
      "esbuild",
      "prisma"
    ]
  }
}
