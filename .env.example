# Pfad ist relativ zu apps/api/prisma/schema.prisma und zeigt auf data/ im Repo-Root
DATABASE_URL="file:../../../data/db.sqlite"

# Ablage für Assets und erzeugte PDFs (relativ zum Repo-Root)
DATA_DIR="./data"

PORT=3000

# Adresse, an die sich der Server bindet. Im Container 0.0.0.0, damit er von
# außerhalb erreichbar ist; lokal reicht die Rückschleife.
HOST=127.0.0.1

# Authentifizierung. Lokal aus — der Server hört dann ohnehin nur auf 127.0.0.1.
# Sobald die Anwendung über Tailscale erreichbar ist: einschalten und mit
# `pnpm user:set <e-mail>` einen Benutzer anlegen.
AUTH_ENABLED=false

# Lebensdauer einer Sitzung in Tagen. Danach ist eine neue Anmeldung nötig.
SESSION_TTL_DAYS=30

# Sitzungs-Cookie nur über HTTPS senden. Standard ist an, sobald AUTH_ENABLED
# gesetzt ist. Auf "false" stellen, wenn die Anwendung über Tailscale ohne
# HTTPS-Terminierung läuft (das Netz selbst ist dann die Verschlüsselung).
COOKIE_SECURE=true

# Fehlgeschlagene Anmeldeversuche pro Zeitfenster, bevor die Adresse pausiert.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Verzeichnis des gebauten Frontends. Leer lassen — der Server findet es neben
# sich (../web/dist). Im Image liegt es an einem festen Ort.
# WEB_ROOT=/app/web

# PDF-Erzeugung: Pfad zu Chromium. Leer lassen, wenn es an einem der üblichen
# Orte liegt (/usr/bin/chromium, /usr/bin/google-chrome, ...) — dann wird es
# gefunden. Im Docker-Image kommt Chromium aus dem Paketmanager und der Pfad
# wird hier gesetzt.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Chromiums eigene Sandbox abschalten. Nur im Container vertretbar, in dem der
# Prozess ohnehin isoliert und unprivilegiert läuft.
PUPPETEER_NO_SANDBOX=false

# Zeitlimit für einen Renderlauf in Millisekunden.
# Erlaubt sind 1000 bis 300000 Millisekunden.
PDF_TIMEOUT_MS=30000
