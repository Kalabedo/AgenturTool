# Konfiguration für den Entwicklungsbetrieb (`pnpm dev`).
#
# Die fertige Anwendung braucht diese Datei nicht: Der Electron-Hauptprozess
# kennt seine Pfade selbst und setzt die Werte beim Start in die Umgebung.

# Pfad ist relativ zu apps/api/prisma/schema.prisma und zeigt auf data/ im Repo-Root
DATABASE_URL="file:../../../data/db.sqlite"

# Ablage für Assets und erzeugte PDFs (relativ zum Repo-Root)
DATA_DIR="./data"

PORT=3000

# Adresse, an die sich der Server bindet. Die Rückschleife, und nichts sonst:
# Die Anwendung enthält Geschäfts- und Kundendaten.
HOST=127.0.0.1

# Authentifizierung. Aus — der Server hört ohnehin nur auf 127.0.0.1, und wer
# am Rechner sitzt, ist angemeldet. Zum Einschalten zusätzlich mit
# `pnpm user:set <e-mail>` einen Benutzer anlegen.
AUTH_ENABLED=false

# Lebensdauer einer Sitzung in Tagen. Danach ist eine neue Anmeldung nötig.
SESSION_TTL_DAYS=30

# Sitzungs-Cookie nur über HTTPS senden. Standard ist an, sobald AUTH_ENABLED
# gesetzt ist.
COOKIE_SECURE=true

# Fehlgeschlagene Anmeldeversuche pro Zeitfenster, bevor die Adresse pausiert.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Verzeichnis des gebauten Frontends. Leer lassen — der Server findet es neben
# sich (../web/dist).
# WEB_ROOT=

# Zeitlimit für einen Renderlauf in Millisekunden.
# Erlaubt sind 1000 bis 300000 Millisekunden.
PDF_TIMEOUT_MS=30000

# Updatefeed der Desktop-Anwendung. Leer lassen — dann gilt die eingebaute
# Adresse (https://updates.agenturtool.de/stable/updates.json). „aus"
# schaltet die Prüfung ganz ab; eine eigene HTTPS-Adresse ersetzt sie, etwa
# um einen neuen Feed vor dem Release auszuprobieren. Gilt nur für die
# Desktop-Anwendung; im Browserbetrieb gibt es keine Updateprüfung.
# AGENTUR_TOOL_UPDATE_FEED=
