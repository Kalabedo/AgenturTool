# Pfad ist relativ zu apps/api/prisma/schema.prisma und zeigt auf data/ im Repo-Root
DATABASE_URL="file:../../../data/db.sqlite"

# Ablage für Assets und erzeugte PDFs (relativ zum Repo-Root)
DATA_DIR="./data"

PORT=3000

# Authentifizierung ist erst ab Schritt 13 implementiert und lokal aus
AUTH_ENABLED=false

# PDF-Erzeugung: Pfad zu Chromium. Leer lassen, wenn es an einem der üblichen
# Orte liegt (/usr/bin/chromium, /usr/bin/google-chrome, ...) — dann wird es
# gefunden. Im Docker-Image kommt Chromium aus dem Paketmanager und der Pfad
# wird hier gesetzt.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Chromiums eigene Sandbox abschalten. Nur im Container vertretbar, in dem der
# Prozess ohnehin isoliert und unprivilegiert läuft.
PUPPETEER_NO_SANDBOX=false

# Zeitlimit für einen Renderlauf in Millisekunden.
PDF_TIMEOUT_MS=30000
